# ── Database ─────────────────────────────────────────────
# 로컬 단독 실행은 기본값(SQLite)으로 충분하다 — 이 파일을 .env로 복사만 해도 동작한다.
# 테이블은 서버 기동 시 자동 생성된다. PostgreSQL은 운영 환경에서만 필요.
DATABASE_URL=sqlite+aiosqlite:///./pccs2.db
# 운영(PostgreSQL) 예시:
# DATABASE_URL=postgresql+asyncpg://pccs:pccs@localhost:5432/pccs2

# ── API / 보안 ───────────────────────────────────────────
API_URL=http://localhost:8000
# 프론트엔드가 도는 출처(여러 개면 콤마로 구분)
CORS_ORIGINS=http://localhost:3000
# 운영에서는 반드시 임의의 비밀키로 교체할 것
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ── RDP-DB 연동 (선택) ───────────────────────────────────
# RDP 가져오기·RDP-DB 화면이 읽고 쓸 로컬 rdp.db 경로.
# 설정하지 않으면 ~/MySecondBrain/Areas/NIFCO/RDP-DB/rdp.db 를 시도한다.
# 그 경로에 파일이 없으면 RDP 화면은 "파일을 찾을 수 없습니다" 로 표시된다.
# RDP_DB_PATH=~/MySecondBrain/Areas/NIFCO/RDP-DB/rdp.db

# ── ML (선택) ────────────────────────────────────────────
ML_MODEL_PATH=models/
